# Legacy iOS bridges; the native Mac target uses Swift packages.
source 'https://cdn.cocoapods.org/'

platform :ios, '27.0'

project 'UsagiUnagi.xcodeproj'

target 'Tsurukame' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!

  # Pods for Tsurukame
  pod 'FMDB', '~> 2.7.5'
  pod 'Reachability', '~> 3.7.7'
  pod 'SwiftGen', '~> 6.0'

  target 'AppTests' do
    inherit! :search_paths
  end

  target 'Tests' do
    inherit! :search_paths

    platform :ios, '27.0'
    pod 'Hippolyte', '~> 1.3.0'
  end
end

# Delete the IPHONEOS_DEPLOYMENT_TARGET config setting so it inherits the
# podfile platform setting.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
    end
  end
end

post_integrate do |installer|
  installer.aggregate_targets.map(&:user_project).uniq.each do |project|
    project.targets.each do |target|
      target.shell_script_build_phases.select { |phase| phase.name.start_with?('[CP]') }.each do |phase|
        guard = 'if [ "$PLATFORM_NAME" = "macosx" ]; then exit 0; fi'
        phase.shell_script = "#{guard}\n#{phase.shell_script}" unless phase.shell_script.start_with?(guard)
      end
    end
    project.save
  end
end
